<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hjc.ark-agent.settle</string>

  <key>ProgramArguments</key>
  <array>
    <!-- 進入點必須是 uv 而非 /bin/bash：macOS 封鎖系統二進位檔在 launchd 下
         存取 ~/Documents 等受保護目錄（防止用腳本繞過 TCC），實測 /bin/bash
         連讀取 daily.py 都會 Operation not permitted。 -->
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>/Users/hjc/Documents/Stock/plugin/plugins/ark-toolkit/skills/ark-agent/daily.py</string>
    <string>settle</string>
  </array>

  <!-- 平日 14:30：收盤（13:30）後一小時，成交與交割數字都已定案。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <!-- 結算與 decide 相反：錯過了**應該**補跑。成交對回、淨值記錄、庫存同步
       都是對既成事實的記錄，晚幾小時做結果一樣，漏做卻會讓熔斷基準斷掉。 -->
  <key>StartCalendarIntervalRunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/hjc/Documents/Stock</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/hjc/.local/bin</string>
    <key>HOME</key>
    <string>/Users/hjc</string>
    <key>ARK_BACKEND</key>
    <string>simulation</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/hjc/.ark-toolkit/agent/launchd.settle.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/hjc/.ark-toolkit/agent/launchd.settle.err</string>
</dict>
</plist>
